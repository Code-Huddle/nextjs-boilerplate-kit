# Prisma ORM Configuration
# Database connection string for Prisma ORM
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Example for different databases:
# PostgreSQL: postgresql://username:password@localhost:5432/database_name
# MySQL: mysql://username:password@localhost:3306/database_name
# SQLite: file:./dev.db

# Optional: Prisma Studio URL (for development)
# BROWSER=none
