# Prisma ORM Configuration
# Database connection string for Prisma ORM
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Example for different databases:
# PostgreSQL: postgresql://username:password@localhost:5432/database_name
# Managed Postgres (Neon/Supabase/RDS/etc.): include sslmode=require
# postgresql://username:password@host:5432/database_name?sslmode=require
# MySQL: mysql://username:password@localhost:3306/database_name
# SQLite: file:./dev.db
#
# Note: Prisma 7 uses node-pg. For remote URLs, src/lib/db.ts appends
# uselibpqcompat=true (and sslmode=require when missing) so sslmode=require is
# not treated as verify-full. For stricter production TLS, prefer
# NODE_EXTRA_CA_CERTS with your provider CA bundle.

# Optional: Prisma Studio URL (for development)
# BROWSER=none
