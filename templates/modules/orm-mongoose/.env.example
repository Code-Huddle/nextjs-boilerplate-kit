# Mongoose ORM Configuration
# MongoDB connection string for Mongoose ORM
MONGODB_URI="mongodb://localhost:27017/nextjs-app"      

# Example for different MongoDB setups:
# Local MongoDB: mongodb://localhost:27017/nextjs-app
# MongoDB with auth: mongodb://username:password@localhost:27017/nextjs-app
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nextjs-app
# MongoDB Atlas with options: mongodb+srv://username:password@cluster.mongodb.net/nextjs-app?retryWrites=true&w=majority